# =================================================================
# ai-ads-autopilot — environment config
# Copy this file to `.env` and fill in the keys. `.env` is gitignored.
# =================================================================

# ---- LEVEL 1: static image ads (required) ----

# Gemini (Nano Banana 2) — generates the still ad creatives
# Get one: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic Claude — writes the creative brief (angles, hooks, copy)
# Get one: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---- LEVEL 2: HeyGen video ads (required for video) ----

# HeyGen — turns the still ad + creator photo + script into a UGC video
# Get one: https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=

# Optional: pre-created avatar/voice ids. Leave blank to have the
# setup wizard help you create a photo avatar from `inputs/creator.jpg`.
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# ---- LEVEL 3 extras (optional, power-user) ----

# Scrape Creators — pulls top competitor ads from the FB Ads Library
# Get one: https://scrapecreators.com/
SCRAPE_CREATORS_API_KEY=

# Tavily — grabs reference images from the web
# Get one: https://tavily.com/
TAVILY_API_KEY=
